# Data are proprietary: code only goes to GitHub. Raw, processed and derived
# tables stay local and are rebuilt by the scripts (folders kept with .gitkeep).
data/raw/*
data/processed/*
outputs/tables/*
!data/raw/.gitkeep
!data/processed/.gitkeep
!outputs/tables/.gitkeep

