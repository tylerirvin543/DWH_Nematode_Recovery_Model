# R and RStudio
.Rproj.user/
.Rhistory
.RData
.Ruserdata

# Quarto
.quarto/
*_files/
*.knit.md

# Code only goes to GitHub. The data are proprietary, so raw data, processed
# data, and everything derived from them (tables, figures, rendered documents)
# stay local and are rebuilt by the scripts. Folders are kept with .gitkeep.
data/raw/*
data/processed/*
outputs/tables/*
outputs/figures/*
!data/raw/.gitkeep
!data/processed/.gitkeep
!outputs/tables/.gitkeep
!outputs/figures/.gitkeep

# Rendered documents (rebuilt from the .qmd files)
/nematode_recovery_paper*.docx
/nematode_recovery_supplement.docx
/nematode_recovery_slides.html
/nematode_recovery_*.pdf
/Draft Nematode project.docx

# Course material that stays local
docs/pitch_notes.pdf
docs/*REVISED*

# Editor and system files
.posit/
.DS_Store
Thumbs.db
desktop.ini
~$*
nul
/meeting_cheatsheet.*
/images/
